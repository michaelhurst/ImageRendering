# Environment: "inside" or "production" (required, no default)
ENVIRONMENT=inside

# HTTP Basic Auth for inside.smugmug.net (required for inside environment)
INSIDE_AUTH_USER=
INSIDE_AUTH_PASS=

# SmugMug session API keys (find in DevTools → Network → look for ?APIKey= on API calls)
SMUGMUG_API_KEY_INSIDE=
SMUGMUG_API_KEY_PRODUCTION=

# Login password for automated+render-testing@smugmug.com (required for API tests)
SMUGMUG_QA_PASSWORD=

# Absolute path to the local test images folder (required)
TEST_IMAGES_DIR=/path/to/test-images
